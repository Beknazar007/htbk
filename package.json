{
  "name": "noorjourney",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "npm run build --workspace=@noorjourney/web",
    "start:web": "npm run start --workspace=@noorjourney/web",
    "lint": "turbo lint",
    "db:generate": "npm run generate --workspace=@noorjourney/database",
    "db:push": "npm run push --workspace=@noorjourney/database",
    "db:seed": "npm run seed --workspace=@noorjourney/database",
    "db:studio": "npm run studio --workspace=@noorjourney/database"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
